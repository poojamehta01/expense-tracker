GEMINI_API_KEY=your_gemini_api_key_here

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
ALLOWED_EMAILS=pooja@gmail.com,kunal@gmail.com

# Stable random session secret — at least 32 characters when MCP is enabled
SESSION_SECRET=replace_with_a_random_secret_of_at_least_32_characters

# Your deployed app URL (no trailing slash). For local dev: http://localhost:3000
BASE_URL=http://localhost:3000

PORT=3000

# Optional MCP server (see docs/mcp-setup.md before enabling)
MCP_ENABLED=false
# Stable JSON values; never commit real private keys or cookie secrets.
MCP_COOKIE_KEYS=
MCP_JWKS=
MCP_ALLOWED_ORIGINS=https://chatgpt.com,https://claude.ai
# Production keeps the existing persistent database:
# DB_PATH=/data/expenses.db
